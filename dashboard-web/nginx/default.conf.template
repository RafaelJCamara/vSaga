# Rendered by the base image's entrypoint into /etc/nginx/conf.d/default.conf. Only the variables named
# by NGINX_ENVSUBST_FILTER (see the Dockerfile) are substituted; every other dollar sign is nginx's own.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# X-Forwarded-Proto: nginx's own scheme, unless DASHBOARD_OUTER_PROXY=true says a TLS terminator sits in
# front, in which case its http or https value is passed on. A client that reaches this container
# directly therefore cannot make the API believe the request came over https.
map "${DASHBOARD_OUTER_PROXY}:$http_x_forwarded_proto" $forwarded_proto {
    default $scheme;
    "~^true:(?<outer_proto>https?)$" $outer_proto;
}

# $uri, not $request: a machine client's access_token query parameter (the API key) never reaches the
# access log. The server block below also raises its error log to crit, because nginx's error lines
# print the full request line and upstream URL, query included, whenever the API is unreachable.
log_format dashboard '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                     '$status $body_bytes_sent $request_time';

server {
    listen 8080;
    server_name _;
    server_tokens off;
    absolute_redirect off;
    access_log /var/log/nginx/access.log dashboard;
    # Request-time messages at error level and below (a refused or unresolved upstream, a timeout) quote
    # the request line with its query, so they are not written at all. The access log still records
    # each such request by path with its 502 or 504, and the API's own logs and health check say why it
    # is down. Start-up and configuration errors keep the base image's main error log.
    error_log /var/log/nginx/error.log crit;
    root /srv/dashboard-web;
    index index.html;

    # The upstream is a variable plus a resolver, so nginx resolves it per request (cached 10 s) rather
    # than once at start: the UI survives the API being recreated with a new address, never ends up
    # proxying to whatever container inherited the old one, and starts while the API is still down.
    # Inside compose, dashboard-api resolves within each project's own network.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $dashboard_api http://${DASHBOARD_API_UPSTREAM};

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;

    # add_header and proxy_set_header are inherited only by locations that declare none of their own,
    # so they live here alone and the locations below cache through expires, never add_header.
    # script-src 'self' forbids inline scripts and on* handlers: the angular CI job checks index.html.
    # 'unsafe-inline' styles are Angular's component styles; WebSocket sources are spelled out.
    # Referrer-Policy same-origin (not no-referrer) keeps Origin non-null on same-origin POSTs.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws://$http_host wss://$http_host; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    proxy_http_version 1.1;
    # $http_host keeps the browser's host:port ($host drops the port); the API's origin checks need it.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;

    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

    # No URI part on proxy_pass (no path, not even a trailing slash): nginx then forwards the request
    # line untouched, so an encoded saga type such as Order%2FSaga stays encoded. Adding a path would
    # make nginx decode %2F and break those routes without any error.
    location ^~ /api/ { proxy_pass $dashboard_api; }
    location ^~ /hubs/ {
        proxy_pass $dashboard_api;
        # Buffering off for SignalR's server-sent events fallback; its long poll holds a request for
        # 90 s, past nginx's 60 s default.
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # index.html revalidates; content-hashed bundles cache for a year, and a missing one is a 404
    # rather than index.html, so a stale tab's chunk request fails as a script, not as HTML.
    location = /index.html { expires -1; }
    location ~ "^/[^/]+-[A-Z0-9]{8}\.(?:js|css)$" { expires 1y; try_files $uri =404; }
    location ^~ /media/ { expires 1y; try_files $uri =404; }
    location / { try_files $uri /index.html; }
}
