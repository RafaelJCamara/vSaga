<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- GenerateDocumentationFile=true activates CS1591 ("missing XML comment on publicly visible
         member") for every undocumented public member, which TreatWarningsAsErrors above turns into
         a build error across all 16 projects. Suppressed here, in the same edit as the flip. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <!-- Packaging metadata: every IsPackable project ships as VSaga.* on nuget.org in lockstep. -->
  <PropertyGroup>
    <Authors>Rafael Camara</Authors>
    <Description>Part of vSaga, a saga orchestration framework for .NET.</Description>
    <PackageProjectUrl>https://github.com/RafaelJCamara/vSaga</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RafaelJCamara/vSaga</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) Rafael Camara</Copyright>
    <PackageTags>vsaga;saga;saga-orchestration;distributed-transactions;dotnet</PackageTags>
    <!-- .snupkg symbol packages + Source Link, so a consumer stepping into vSaga code from their
         debugger lands on the exact commit that built the package, not a "no source available"
         wall. PublishRepositoryUrl/EmbedUntrackedSources are Source Link's own required pair;
         ContinuousIntegrationBuild strips local machine paths from the PDB, which only matters (and
         is only reliably true) in CI, not an arbitrary local `dotnet pack`. Source Link itself needs
         no PackageReference: the SDK has shipped it in-box since .NET 8, and the standalone
         Microsoft.SourceLink.GitHub package drags in Microsoft.Build.Tasks.Git 8.0.0, whose advisory
         (GHSA-23fw-v26w-5fgq) NuGetAudit turns into NU1902 and TreatWarningsAsErrors turns into a
         restore failure across every project. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Each package's own README.md, when its project directory has one; see the ItemGroup below. -->
    <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)\README.md')">README.md</PackageReadmeFile>
    <!-- Shared icon for every package, so nuget.org shows a real thumbnail instead of the generic
         placeholder. Referenced relative to this file's own directory (not MSBuildProjectDirectory) so
         it resolves the same regardless of which src/tests subdirectory a given project lives in. -->
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true' and Exists('$(MSBuildProjectDirectory)\README.md')">
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Versioning: MinVer derives the version from git tags, with no version string committed
       anywhere. MinVerTagPrefix matches this project's v* tag convention (e.g. v0.1.0) for whenever a
       release is tagged; no automated release workflow exists yet, so tagging and publishing are manual. -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!-- MinVer can't tell a shallow checkout (fetch-depth: 1, the GitHub Actions default) apart from a
       repo that genuinely has no tags yet: both resolve to the same 0.0.0-prefixed fallback. A shallow
       checkout hiding a real tag would otherwise pack and publish that fake version silently, which is
       worse than refusing to pack. Scoped to Pack (not Build/Test) so ordinary per-commit
       build/test verification keeps working before the first tag exists.

       $(MinVerVersionOverride) is empty in this genuine no-tag/shallow-checkout case and non-empty only
       when the caller explicitly passed -p:MinVerVersionOverride=..., so the two targets below use it to
       tell the cases apart and each report the cause that actually applies. -->
  <Target Name="VSagaFailOnUnresolvedMinVerVersion" BeforeTargets="GenerateNuspec" DependsOnTargets="MinVer"
          Condition="'$(IsPackable)' == 'true' AND '$(MinVerVersionOverride)' == '' AND '$(MinVerMajor)' == '0' AND '$(MinVerMinor)' == '0' AND '$(MinVerPatch)' == '0'">
    <Error Text="MinVer resolved $(MSBuildProjectName)'s version to the untagged fallback 0.0.0 (no reachable git tag). This usually means the checkout is shallow (missing fetch-depth: 0) or the repository has no version tag yet. Refusing to pack a fake 0.0.0 version. For local testing without a tag, pass -p:MinVerVersionOverride=x.y.z-local to dotnet pack." />
  </Target>

  <!-- Same 0.0.0 guard, but for when the caller passed an explicit -p:MinVerVersionOverride whose own
       major.minor.patch is 0.0.0 (e.g. -p:MinVerVersionOverride=0.0.0-fieldtest). That is not a
       missing-tag/shallow-checkout situation (MinVerVersionOverride bypasses tag resolution entirely),
       so the message above would misdiagnose the cause. Point at the override itself instead. -->
  <Target Name="VSagaFailOnZeroMinVerVersionOverride" BeforeTargets="GenerateNuspec" DependsOnTargets="MinVer"
          Condition="'$(IsPackable)' == 'true' AND '$(MinVerVersionOverride)' != '' AND '$(MinVerMajor)' == '0' AND '$(MinVerMinor)' == '0' AND '$(MinVerPatch)' == '0'">
    <Error Text="The -p:MinVerVersionOverride=$(MinVerVersionOverride) value passed to $(MSBuildProjectName) has a major.minor.patch of 0.0.0, which this guard also rejects (a 0.0.0 base isn't a meaningful package version even for local testing). Pick a non-zero base instead, e.g. -p:MinVerVersionOverride=1.0.0-local." />
  </Target>

  <!-- Static code analysis: built-in .NET analyzers + SonarQube/Meziantu/AsyncFixer, enforced via .editorconfig -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="AsyncFixer" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

</Project>
