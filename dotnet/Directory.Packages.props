<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AsyncFixer" Version="2.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <!-- MassTransit v9 is commercially licensed; bounded below 9.0.0 so a consumer's own restore can
         never silently resolve past the last Apache-2.0 8.x release. -->
    <PackageVersion Include="MassTransit.RabbitMQ" Version="[8.5.8,9.0.0)" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.177">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <!-- Apache-2.0, the official driver. Bounded below 4.0.0 like the bus SDKs above so a consumer restore
         never silently floats onto an untested next-major release. The native driver, not the MongoDB
         EF Core provider: VSaga.Persistence.EFCore is relational-only (FromSqlInterpolated, HasFilter). -->
    <PackageVersion Include="MongoDB.Driver" Version="[3.6.0,4.0.0)" />
    <!-- Transitive pins, not direct references: MongoDB.Driver 3.6 declares SharpCompress 0.30.1 and
         Snappier 1.0.0, both under NuGet advisories (GHSA-6c8g-7p36-r338, GHSA-pggp-6c3x-2xmx) that
         TreatWarningsAsErrors turns into a solution-wide restore failure, the failure class
         Directory.Build.props already records once, over Microsoft.Build.Tasks.Git. With
         CentralPackageTransitivePinningEnabled these entries lift the transitives to patched versions. -->
    <PackageVersion Include="SharpCompress" Version="0.50.4" />
    <PackageVersion Include="Snappier" Version="1.3.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <!-- Bounded the same way as the other two bus SDKs in this file: a consumer's own restore should
         never silently float onto an untested next-major release. RMQ.Async is the async-native gateway
         package built on RabbitMQ.Client v7, matching this repo's own RabbitMQ.Client 7.2.2 pin below. -->
    <PackageVersion Include="Paramore.Brighter" Version="[10.7.0,11.0.0)" />
    <PackageVersion Include="Paramore.Brighter.MessagingGateway.RMQ.Async" Version="[10.7.0,11.0.0)" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <!-- MIT, the de facto .NET client. Bounded below 4.0.0 like the bus SDKs above so a consumer restore
         never silently floats onto an untested next-major release. No NRedisStack: that package exists for
         the module commands (RediSearch, RedisJSON) the Redis provider deliberately does not use. -->
    <PackageVersion Include="StackExchange.Redis" Version="[3.0.11,4.0.0)" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.33.0.1635">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.14.0" />
    <!-- Bounded the same way as the other two bus SDKs in this file: a consumer's own restore should
         never silently float onto an untested next-major release. -->
    <PackageVersion Include="WolverineFx" Version="[6.30.0,7.0.0)" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="[6.30.0,7.0.0)" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="[6.30.0,7.0.0)" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <!-- The pieces of xunit 2.9.3, at the versions it already resolves to, for
         VSaga.Persistence.Conformance: a library of abstract test classes needs the attributes and
         assertions but not xunit.core's build files, which exist for runnable test projects (they set
         IsTestProject=true and emit a runtimeconfig.json into whatever references them). -->
    <PackageVersion Include="xunit.analyzers" Version="1.18.0" />
    <PackageVersion Include="xunit.assert" Version="2.9.3" />
    <PackageVersion Include="xunit.extensibility.core" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
  </ItemGroup>
</Project>