{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "VSaga": "Host=localhost;Port=5432;Database=vsaga;Username=postgres;Password=postgres"
  },
  "Transport": {
    "Provider": "RabbitMq"
  },
  "RabbitMq": {
    "ConnectionString": "amqp://guest:guest@localhost:5672/"
  },
  "Chaos": {
    "Enabled": false
  },
  "OrderSubmitter": {
    "SeedOrders": 10,
    "MaxOrdersPerRequest": 50
  }
}
