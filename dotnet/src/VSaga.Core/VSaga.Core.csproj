<Project Sdk="Microsoft.NET.Sdk">

  <!-- Package-specific description for nuget.org search results, overriding Directory.Build.props's
       shared fallback (MSBuild evaluates that file first, so this later value wins). -->
  <PropertyGroup>
    <Description>The vSaga orchestration engine: the fluent saga DSL (states, steps, compensation, timeouts, fan-out/join) and the runtime that drives orchestrated and choreographed sagas.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- .CallHttp (docs/design/http-based-sagas.md §5.2/§5.3) needs ISagaContextLogSink to write its own
         request/reply timeline entries, the same reason VSaga.Dashboard.Api.Tests gets this for
         SagaChangePollingService. -->
    <InternalsVisibleTo Include="VSaga.Http" />
    <!-- SagaTestHarness needs to type-check for SagaTimeoutDispatcherHostedService/SagaOutboxDispatcherHostedService
         so it can skip starting them: both are TimeProvider-driven background pollers that would
         otherwise race the harness's own deterministic AdvanceTimeByAsync claim-and-handle path the
         moment its FakeTimeProvider is advanced. -->
    <InternalsVisibleTo Include="VSaga.Testing" />
    <!-- The stuck-saga classifier and sweep are internal, and their tests drive them directly: every boundary of the
         definition of "stuck" is a unit case, without a host and a clock. -->
    <InternalsVisibleTo Include="VSaga.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VSaga.Abstractions\VSaga.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
