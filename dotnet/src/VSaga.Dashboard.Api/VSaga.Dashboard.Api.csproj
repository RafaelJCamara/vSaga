<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A deployable app, not a library — opt out of the repo-wide IsPackable=true default. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- SagaChangePollingService is internal on purpose (it is composition-root wiring, not API
         surface) but carries real diff/watermark logic worth testing directly. Exposing internals to
         the test project keeps it testable without promoting it to public. -->
    <InternalsVisibleTo Include="VSaga.Dashboard.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Not used at runtime — the `dotnet ef migrations` tooling requires its startup project to
         directly reference this package (a transitive reference from VSaga.Persistence.EFCore isn't
         enough, since that project marks it PrivateAssets="all"). PrivateAssets="all" here too so it
         doesn't ship in the published output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VSaga.Observability\VSaga.Observability.csproj" />
    <!-- Brings in VSaga.Persistence.EFCore transitively; referenced directly (rather than the plain
         VSaga.Persistence.EFCore project) so the Npgsql-specific EF Core migrations assembly is
         present in this app's output for MigrationsAssembly(...)/MigrateAsync() to find at runtime. -->
    <ProjectReference Include="..\VSaga.Persistence.EFCore.Postgres\VSaga.Persistence.EFCore.Postgres.csproj" />
    <ProjectReference Include="..\VSaga.Persistence.Redis\VSaga.Persistence.Redis.csproj" />
    <ProjectReference Include="..\VSaga.Transport.RabbitMQ\VSaga.Transport.RabbitMQ.csproj" />
    <ProjectReference Include="..\VSaga.Transport.Http\VSaga.Transport.Http.csproj" />
  </ItemGroup>

</Project>
