<Project Sdk="Microsoft.NET.Sdk">

  <!-- Package-specific description for nuget.org search results, overriding Directory.Build.props's
       shared fallback (MSBuild evaluates that file first, so this later value wins). -->
  <PropertyGroup>
    <Description>MongoDB persistence for vSaga: saga snapshot storage, the event log, timeouts and the transactional outbox on the native MongoDB.Driver, with a short multi-document transaction committing each snapshot and its staged outbox rows together. Requires a replica set; see docs/persistence.md.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The unit of work's outbox-only commit and the document types are internal: the conformance
         fixture needs the first to make a staged row durable without a persist, and the provider's own
         tests inspect stored documents. Neither is API surface. -->
    <InternalsVisibleTo Include="VSaga.Persistence.MongoDB.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VSaga.Abstractions\VSaga.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

</Project>
